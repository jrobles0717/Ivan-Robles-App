# Copy to .env for local development. In production, set these in
# Netlify: Site settings > Environment variables.

# YouTube video ID for the premiere section (optional)
VITE_PREMIERE_VIDEO_ID=

# Shopify Storefront API (shop page)
# Store domain, e.g. your-store.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=
# Storefront API access token from Shopify Admin > Apps > Develop apps
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional — defaults to a recent stable Storefront API version
VITE_SHOPIFY_API_VERSION=
